rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ranking do jogo "Onde fica?" (Atlas Macacu)
    match /ranking_localidades/{id} {
      allow read: if true;
      // Qualquer pessoa pode registrar uma partida, mas só com os campos certos
      // e valores possíveis. Ninguém pode editar nem apagar pelo site.
      allow create: if request.resource.data.keys().hasOnly(['nome','turma','acertos','total','tempo','data'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 30
        && request.resource.data.turma is string && request.resource.data.turma.size() <= 30
        && request.resource.data.acertos is int
        && request.resource.data.total is int
        && request.resource.data.acertos >= 0 && request.resource.data.acertos <= request.resource.data.total
        && request.resource.data.total <= 61
        && request.resource.data.tempo is number
        && request.resource.data.tempo >= request.resource.data.total * 1.0
        && request.resource.data.tempo < 7200
        && request.resource.data.data == request.time;
      allow update, delete: if false;
    }
  }
}
